fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c185"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c188" value="follows up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endFill=0;startArrow=none;endArrow=open;endSize=8;strokeColor=#6c8ebf;exitX=1;exitY=0.85;entryX=1;entryY=0.9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c189" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c188"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c190" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c188"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c191" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endFill=0;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c90" target="c94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c192" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c191"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c193" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c191"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c194" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endFill=0;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c90" target="c96"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c195" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c194"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c196" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c194"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c197" value="&lt;b&gt;Gist SQLite data model: proposal for review&lt;/b&gt;&lt;br&gt;&lt;br&gt;
&lt;b&gt;One database, all profiles.&lt;/b&gt; Every root table carries profile_id; children cascade from it. Deleting a profile is one DELETE. Finding any profile&#x27;s waiting alarm (they all ring) is one query.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Normalised from today&#x27;s JSON blobs:&lt;/b&gt; the check-in list, results (one JSON object for every day), pending queue, sets such as sharedWith, and the connection and device maps become rows. Repeats become kind + bitmask + date.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Merged:&lt;/b&gt; times (AlarmTime) and event triggers become one trigger table. Places become reusable rows. Linked-from fields move to linked_checkin (0..1).&lt;br&gt;&lt;br&gt;
&lt;b&gt;Soft reference:&lt;/b&gt; answer.question_id has no FK, so history survives a deleted question (as today).&lt;br&gt;&lt;br&gt;
&lt;b&gt;«device-only»&lt;/b&gt; columns never sync to your other devices. &lt;b&gt;«secret»&lt;/b&gt; columns are encryption keys: keep them in Keystore / Keychain, or encrypt the DB (SQLCipher).&lt;br&gt;&lt;br&gt;
&lt;b&gt;Stays outside the DB:&lt;/b&gt; photo, video and clip bytes (files; media_file indexes them). Transient OS caches stay outside too: geofence signatures and run milestones.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Sync format unchanged:&lt;/b&gt; items still go to the Gist folder as JSON, so Android and iOS keep interoperating. Backups and YAML export stay JSON.&lt;br&gt;&lt;br&gt;
Times are epoch ms (INTEGER). Days are yyyy-MM-dd TEXT. Booleans are INTEGER 0/1. Versioning uses PRAGMA user_version, and PRAGMA foreign_keys = ON." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;size=18;" vertex="1" parent="1"><mxGeometry x="850" y="1330" width="1210" height="400" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;◆── composition (owner side; child deleted with it)&lt;br&gt;──&amp;gt; association (FK)&lt;br&gt;- - -&amp;gt; soft reference (no FK enforced)&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = primary key column · {FK → t} foreign key · NN not null" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="1750" width="1210" height="90" as="geometry"/></mxCell><mxCell id="c199" value="Gist: SQLite data model (proposal, v1)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="800" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>